{
  "name": "orange-pos-desktop",
  "version": "1.0.5",
  "description": "ORANGE - واجهة نقطة البيع (Electron + React)",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc -p tsconfig.json && vite build",
    "build": "npx vite build",
    "build:electron": "npm run build:web && tsc -p electron/tsconfig.json && electron-builder --config.win.signAndEditExecutable=false",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "electron:build": "npm run build:electron"
  },
  "build": {
    "appId": "com.orangepos.app",
    "productName": "ORANGE POS",
    "directories": {
      "output": "release"
    },
    "compression": "store",
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/sqlite3/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORANGE POS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "ORANGE POS"
    },
    "publish": {
      "provider": "github",
      "owner": "omarahmed9150",
      "repo": "Orange-pos-"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.7.9",
    "electron-updater": "^6.8.9",
    "jsbarcode": "^3.11.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "serialport": "^12.0.0",
    "tesseract.js": "^5.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
