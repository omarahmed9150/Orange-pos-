# قاعدة بيانات محلية بالكامل (SQLite) - لا حاجة لأي سيرفر خارجي أو إنترنت
DATABASE_URL="file:./orange.db"
PORT=3000
HOST=0.0.0.0
# Add the deployed frontend URL when hosting the API remotely.
CORS_ORIGINS="http://localhost:5173"

# مفتاح تشفير الجلسات (JWT) - غيّره قبل النشر الفعلي
JWT_SECRET="generate-a-long-random-secret-before-starting"
JWT_EXPIRES_IN="12h"

PORT=3000
HOST=127.0.0.1
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# بوت تليغرام للنسخ الاحتياطي التلقائي اليومي (اختياري)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# SMTP للنسخ الاحتياطي عبر البريد (اختياري)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
