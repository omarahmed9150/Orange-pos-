# PostgreSQL connection string. Render supplies this automatically.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
PORT=3000
HOST=0.0.0.0
# Add the deployed frontend URL when hosting the API remotely.
CORS_ORIGINS="https://omarahmed9150.github.io"

# مفتاح تشفير الجلسات (JWT) - غيّره قبل النشر الفعلي
JWT_SECRET="generate-a-long-random-secret-before-starting"
JWT_EXPIRES_IN="12h"

# بوت تليغرام للنسخ الاحتياطي التلقائي اليومي (اختياري)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# SMTP للنسخ الاحتياطي عبر البريد (اختياري)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
